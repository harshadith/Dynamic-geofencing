{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in the safety system",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["tourist", "admin"] },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "lastLogoutAt": { "type": "string" },
        "isOnline": { "type": "boolean" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Traveller": {
      "title": "Traveller",
      "description": "Active real user participating in live travel monitoring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "status": { "type": "string", "enum": ["safe", "warning", "critical", "sos"] },
        "batteryLevel": { "type": "number" },
        "safetyScore": { "type": "number" },
        "geofenceStatus": { "type": "string", "enum": ["inside_safe", "outside_safe", "in_danger"] },
        "lastCheckIn": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "name", "lat", "lng", "status", "batteryLevel", "safetyScore", "geofenceStatus"]
    },
    "Geofence": {
      "title": "Geofence",
      "description": "Dynamic or manual safety geofence zone",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "radius": { "type": "number" },
        "riskLevel": { "type": "string", "enum": ["safe", "moderate", "high", "critical"] },
        "description": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdById": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "lat", "lng", "radius", "riskLevel", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user profiles with role authorization"
    },
    "/travellers/{travellerId}": {
      "schema": "Traveller",
      "description": "Real-time location and telemetry of logged-in travellers"
    },
    "/geofences/{geofenceId}": {
      "schema": "Geofence",
      "description": "Active and historical geofence containment areas"
    }
  }
}
