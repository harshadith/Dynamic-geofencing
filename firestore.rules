rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents (accessible to authenticated travellers and app visitors)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Real-time traveller telemetry monitoring
    match /travellers/{travellerId} {
      allow read, write: if true;
    }

    // Geofences
    match /geofences/{geofenceId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
